# ============================================================================
# Inkwell 生产环境变量（复制为 .env.prod 后修改；.env.prod 已被 .gitignore 忽略）
#   cp .env.prod.example .env.prod
# ============================================================================

# MySQL root 密码。注意：
#   - 首次启动时 MySQL 用它初始化，之后改这里的值不会改数据库里的密码
#   - 后端容器用它连库（SPRING_DATASOURCE_PASSWORD），所以数据库密码和这里必须一致
#   - 生成方式：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_password

# JWT 签名密钥，必须是 Base64 编码且解码后 >= 256 bit（32 字节）
# 生成方式：openssl rand -base64 48
# 留空或太短会导致后端启动失败
JWT_SECRET=CHANGE_ME_base64_secret_at_least_32_bytes

# 站点对外地址，注入给 blog-server（blog.site-url），用于 RSS / Sitemap 里的绝对链接
# 结尾斜杠会被去掉；填你的公网地址或域名，例如 http://<服务器公网IP>、https://blog.example.com
# 注意：不要把真实 IP/域名/密钥提交进 git（.env.prod 已被忽略）
SITE_URL=http://CHANGE_ME_server_ip_or_domain

# 可选：前端镜像构建时的 npm 源，默认已用国内镜像
# NPM_REGISTRY=https://registry.npmmirror.com
